{
  "name": "@firstlook/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "eval:capture": "tsx src/evals/capture.ts",
    "eval": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@firstlook/shared": "workspace:*",
    "@firstlook/telemetry": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
